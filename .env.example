# Log
LOG_FILE=logs/app.log
LOG_LEVEL=INFO

# Telegram
TELEGRAM_TOKEN=

# Agent
LLM_PROVIDER=ollama
API_KEY=
LLM_MODEL=gemma4:26b
LLM_REASONING=true
MAX_TOOL_RETRY=5

# Router
ROUTER_TYPE=semantic
ROUTER_PROVIDER=ollama
ROUTER_MODEL=gemma4:26b
ROUTER_REASONING=true
MAX_TOOL=5
TOOL_KB=data/tool_kb.json

# Embedding
# nomic-embed-text-v2-moe:latest - 768
# Qwen3-Embedding-0.6B - 1024
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
DIMENSION=

# GG sheet
CREDENTIAL=path/to/json
SHEET_KEY=

# Langfuse
TRACING=true
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=